---
// Blog listesi: en yeni yazı geniş bir kartta (kapak yanında), kalanlar iki sütunlu ızgarada.
// Türkçe ve İngilizce index sayfaları aynı düzeni kullanır.
import type { CollectionEntry } from 'astro:content';
import BlogCover from './Cover.astro';
import Icon from '../ui/Icon.astro';
import { formatDate, readingTime } from '../../lib/utils';
import { getMessages } from '../../messages';
import { blogPostPath, blogSlugFromId } from '../../i18n/routes';
import type { Locale } from '../../i18n/utils';

interface Props {
  posts: CollectionEntry<'blog'>[];
  locale: Locale;
}
const { posts, locale } = Astro.props;
const { blog } = getMessages(locale);
const [latest, ...rest] = posts;
const href = (post: CollectionEntry<'blog'>) => blogPostPath(blogSlugFromId(post.id, locale), locale);
const card =
  'group block rounded-[28px] bg-surface shadow-[0_1px_0_var(--k-line)] transition-shadow hover:shadow-[0_12px_32px_-18px_var(--k-line)]';
---

{
  latest && (
    <a
      href={href(latest)}
      class:list={[card, 'grid gap-6 p-4 sm:p-5 md:grid-cols-[1.15fr_1fr] md:items-center md:gap-8']}
    >
      {latest.data.cover && (
        <BlogCover
          cover={latest.data.cover}
          alt={latest.data.coverAlt ?? latest.data.title}
          width={720}
          loading="eager"
          class="aspect-[1200/630] w-full rounded-[22px] object-cover"
        />
      )}
      <div class="px-2 pb-3 md:px-0 md:pr-4 md:pb-0">
        <span class="inline-flex rounded-full bg-primary px-3 py-1 text-xs font-medium text-on-primary">
          {blog.latest}
        </span>
        <h2 class="font-display mt-4 text-3xl leading-tight text-balance">{latest.data.title}</h2>
        <p class="mt-3 leading-relaxed text-muted-foreground">{latest.data.description}</p>
        <p class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
          <span class="text-muted-foreground">
            <time datetime={latest.data.date.toISOString()}>{formatDate(latest.data.date, locale)}</time>
            {' · '}
            {readingTime(latest.body ?? '')} {blog.minRead}
          </span>
          <span class="inline-flex items-center gap-1 font-medium text-primary-text">
            {blog.readMore}
            <Icon name="ArrowRight01Icon" class="size-4 transition-transform group-hover:translate-x-0.5" />
          </span>
        </p>
      </div>
    </a>
  )
}

{
  rest.length > 0 && (
    <ul class="mt-6 grid gap-6 sm:grid-cols-2">
      {rest.map((post) => (
        <li>
          <a href={href(post)} class:list={[card, 'h-full p-4']}>
            {post.data.cover && (
              <BlogCover
                cover={post.data.cover}
                alt={post.data.coverAlt ?? post.data.title}
                width={560}
                class="aspect-[1200/630] w-full rounded-[22px] object-cover"
              />
            )}
            <div class="px-2 pt-4 pb-2">
              <p class="text-sm text-muted-foreground">
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, locale)}</time>
                {' · '}
                {readingTime(post.body ?? '')} {blog.minRead}
              </p>
              <h2 class="font-display mt-2 text-xl leading-snug">{post.data.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{post.data.description}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  )
}
