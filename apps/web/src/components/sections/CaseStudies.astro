---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Badge from '../ui/Badge.astro';
import { getMessages } from '../../messages';
import type { Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { caseStudies } = getMessages(locale);
---

<Section id="case-studies" class="bg-surface">
  <Container>
    <SectionHeading eyebrow={caseStudies.eyebrow} title={caseStudies.title} />
    <div class="grid gap-6 lg:grid-cols-3">
      {
        caseStudies.items.map((item) => (
          <article class="flex flex-col rounded-[28px] bg-background p-7">
            <p class="label">
              {item.metric}, {item.metricLabel}
            </p>
            <h3 class="font-display mt-3 text-2xl">{item.title}</h3>
            <p class="mt-3 flex-1 leading-relaxed text-muted-foreground">{item.summary}</p>
            <div class="mt-6 flex flex-wrap gap-2">
              {item.tags.map((tag) => (
                <Badge>{tag}</Badge>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </Container>
</Section>
