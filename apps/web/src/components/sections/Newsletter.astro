---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { getMessages } from '../../messages';
import { siteConfig } from '../../config/site.config';
import type { Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { newsletter } = getMessages(locale);
---

<Section id="newsletter" class="!pt-4 !pb-24">
  <Container class="max-w-5xl">
    <div
      class="grid items-center gap-6 rounded-[28px] bg-tint p-6 text-on-tint sm:p-10 md:grid-cols-[1fr_1.1fr] md:gap-10"
    >
      <div class="flex items-start gap-4">
        <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-surface">
          <Icon name="Mail01Icon" class="size-6 text-primary-text" />
        </span>
        <div>
          <h2 class="font-display text-3xl">{newsletter.title}</h2>
          <p class="mt-2 leading-relaxed text-muted-foreground">{newsletter.description}</p>
        </div>
      </div>
      <div>
        <!--
      Form JSON olarak Koina API'ye gider (src/lib/newsletter.ts); JS yoksa `action`a düz POST
      düşer. `data-astro-reload`: ClientRouter POST formlarını yakalayıp kendi fetch'ini yapardı.
      Etiket sr-only: placeholder erişilebilir ad DEĞİLDİR (odaklanınca kaybolur, WCAG 1.3.1/3.3.2).
    -->
        <form
          method="post"
          action={siteConfig.newsletter.action || '#'}
          data-astro-reload
          data-newsletter
          data-locale={locale}
          data-sending={newsletter.sending}
          data-success={newsletter.success}
          data-error={newsletter.error}
          class="flex gap-2"
        >
          <label class="sr-only" for="newsletter-email">{newsletter.emailLabel}</label>
          <input
            id="newsletter-email"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder={newsletter.placeholder}
            class="h-12 w-full rounded-full border-2 border-line bg-surface px-5 text-[15px] placeholder:text-muted-foreground focus:border-accent focus:outline-none"
          />
          <!-- Bal küpü: insanlar görmez, botlar doldurur; API dolu gelen kaydı reddeder. -->
          <input
            type="text"
            name="website"
            tabindex="-1"
            autocomplete="off"
            class="hidden"
            aria-hidden="true"
          />
          <Button type="submit" size="lg" analytics={{ event: 'newsletter_submit' }}
            >{newsletter.subscribe}</Button
          >
        </form>
        <p
          data-newsletter-status
          role="status"
          aria-live="polite"
          class="mt-3 min-h-6 text-sm text-muted-foreground"
        >
        </p>
      </div>
    </div>
  </Container>
</Section>

<script>
  import { initNewsletter } from '../../lib/newsletter';
  document.addEventListener('astro:page-load', initNewsletter);
</script>
