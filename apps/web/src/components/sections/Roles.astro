---
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import { routePath, type RouteKey } from '../../i18n/routes';
import team from '../../assets/photos/team.jpg';
import pairing from '../../assets/photos/pairing.jpg';
import cowork from '../../assets/photos/cowork.jpg';
import { getMessages } from '../../messages';
import type { Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { roles } = getMessages(locale);
const anchor = locale === 'tr' ? 'nasil' : 'how';
const photos: Record<string, ImageMetadata> = { learner: team, mentor: pairing, founder: cowork };
---

<Section id={anchor}>
  <Container>
    <SectionHeading eyebrow={roles.eyebrow} title={roles.title} description={roles.description} />
    <div class="grid gap-6 lg:grid-cols-3">
      {
        roles.items.map((role) => (
          <article class="flex flex-col rounded-[28px] bg-surface p-3 shadow-[0_1px_0_var(--k-line)]">
            <Image
              src={photos[role.key]}
              alt={role.photoAlt}
              widths={[400, 640, 800]}
              sizes="(min-width: 1024px) 360px, 100vw"
              class="aspect-[4/3] w-full rounded-[20px] object-cover"
            />
            <div class="flex flex-1 flex-col px-4 pt-6 pb-5">
              <h3 class="font-display text-2xl">{role.name}</h3>
              <p class="mt-2 text-muted-foreground">{role.who}</p>
              <p class="mt-5 rounded-2xl bg-background px-4 py-3 text-[15px]">
                <span class="font-semibold">{roles.giveLabel}: </span>
                {role.give}
              </p>
              <p class="label mt-5">{roles.getLabel}</p>
              <ul class="mt-2 space-y-2 text-[15px]">
                {role.get.map((g) => (
                  <li class="flex gap-2.5">
                    <Icon name="CheckmarkCircle02Icon" class="mt-0.5 size-5 shrink-0 text-primary-text" />
                    {g}
                  </li>
                ))}
              </ul>
              <a
                href={routePath(role.route as RouteKey, locale)}
                class="group mt-auto inline-flex items-center gap-1.5 pt-6 font-semibold text-primary-text"
              >
                {roles.more}
                <Icon
                  name="ArrowRight01Icon"
                  class="size-4 transition-transform group-hover:translate-x-0.5"
                  strokeWidth={2}
                />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </Container>
</Section>
