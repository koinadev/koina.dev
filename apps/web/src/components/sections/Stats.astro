---
import Container from '../ui/Container.astro';
import { getMessages } from '../../messages';
import type { Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { stats } = getMessages(locale);
---

<!--
  DİKKAT: HTML `dl` içerik modeli `dt`'nin `dd`'den ÖNCE gelmesini şart koşar. Görsel olarak büyük
  sayının üstte durması `flex-col-reverse` ile sağlanır — DOM sırası spec'e uygun kalır.
-->
<section class="pb-8">
  <Container>
    <dl class="grid grid-cols-2 gap-y-10 text-center lg:grid-cols-4">
      {
        stats.items.map((item) => (
          <div class="flex flex-col-reverse gap-1">
            <dt class="text-muted-foreground">{item.label}</dt>
            <dd
              class="font-display text-5xl tabular-nums"
              data-counter={String(item.value)}
              data-counter-suffix={item.suffix}
            >
              {item.value}
              {item.suffix}
            </dd>
          </div>
        ))
      }
    </dl>
  </Container>
</section>
