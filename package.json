{
  "name": "koina",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun --filter @koina/web dev",
    "dev:api": "bun --filter @koina/api dev",
    "dev:mobile": "bun --filter @koina/mobile start",
    "dev:app": "bun --filter @koina/app dev",
    "build": "bun --filter @koina/web build",
    "check": "bun --filter '*' check",
    "test": "bun --filter '*' test",
    "deploy:web": "bun --filter @koina/web deploy",
    "deploy:api": "bun --filter @koina/api deploy",
    "deploy:app": "bun --filter @koina/app deploy",
    "infra:up": "bun --filter @koina/db infra:up",
    "infra:down": "bun --filter @koina/db infra:down",
    "db:migrate": "bun --filter @koina/db db:migrate",
    "seed": "bun --filter @koina/api seed"
  }
}
