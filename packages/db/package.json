{
  "name": "@koina/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "exports": {
    ".": "./src/index.ts",
    "./management": "./src/management.ts",
    "./middleware": "./src/middleware.ts",
    "./tools": "./src/tools.ts",
    "./auth": "./src/auth.ts",
    "./telemetry": "./src/telemetry.ts",
    "./drivers/*": "./src/core/drivers/*.ts",
    "./queries/*": "./src/queries/*.gen.ts",
    "./repositories/*": "./src/repositories/*/index.ts",
    "./tables/*": "./src/tables/*.gen.ts",
    "./repositories/_lib/*": "./src/repositories/_lib/*.ts"
  },
  "scripts": {
    "cli": "bun src/core/cli.ts",
    "db:migrate": "bun src/core/cli.ts migrate",
    "db:rollback": "bun src/core/cli.ts migrate-down",
    "db:status": "bun src/core/cli.ts migration-status",
    "db:seed": "bun src/core/cli.ts seed",
    "db:generate": "bun src/core/cli.ts migration create",
    "db:generate:seed": "bun src/core/cli.ts seed create",
    "db:generate:auth": "bun src/core/cli.ts auth generate",
    "db:pull": "bun src/core/cli.ts pull",
    "db:codegen": "bun src/core/sql/codegen.ts",
    "test": "bun test src/__tests__/unit src/repositories",
    "test:integration": "echo \"no integration tests\"",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && bun run db:codegen --check",
    "infra:up": "docker compose -p koina up -d --wait",
    "infra:down": "docker compose -p koina down"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "pgsql-ast-parser": "12.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@types/bun": "1.4.2",
    "@types/pg": "8.23.1",
    "better-auth": "1.7.5",
    "pg": "8.23.0",
    "postgres": "3.4.7",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "better-auth": "1.7.5",
    "pg": "^8.23.0",
    "postgres": "^3.4.7"
  },
  "peerDependenciesMeta": {
    "@neondatabase/serverless": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "postgres": {
      "optional": true
    }
  },
  "license": "AGPL-3.0-only"
}
