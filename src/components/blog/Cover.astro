---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Blog kapak görseli. Şemadaki `cover` alanı bir BİRLEŞİM olduğu için (yerel `ImageMetadata`
 * ya da uzak URL string'i) dallanma TEK yerde, burada yapılır — index kartı ve yazı sayfası
 * ayrı ayrı aynı koşulu yazmak zorunda kalmasın.
 *
 * İki dal da BUILD ZAMANINDA optimize edilir: yerel dosyalar Vite üzerinden, uzak URL'ler
 * `image.remotePatterns` yetkisiyle indirilip dönüştürülerek (bkz. astro.config.mjs).
 */
interface Props {
  cover: ImageMetadata | string;
  alt: string;
  /** Görselin yerleşimdeki en büyük genişliği; srcset bunun etrafında üretilir. */
  width: number;
  class?: string;
  /** Kart listelerinde `lazy`, yazı başındaki kapakta `eager` (LCP adayı). */
  loading?: 'lazy' | 'eager';
}
const { cover, alt, width, class: className, loading = 'lazy' } = Astro.props;
// 16:9 — kapaklar için sabit oran. Uzak görselde `inferSize` gerçek oranı getirir, bu değer
// yalnızca yerel dalda kırpma/ölçek referansı olarak kullanılır.
const height = Math.round(width * (9 / 16));
---

{
  typeof cover === 'string' ? (
    // UZAK: boyutlar önceden bilinmiyor. `inferSize` build sırasında görseli okuyup gerçek
    // en/boy'u çıkarır — bu olmadan Astro uzak görsele width/height yazamaz ve CLS oluşur.
    <Image src={cover} alt={alt} inferSize width={width} class={className} loading={loading} />
  ) : (
    // YEREL: `ImageMetadata` intrinsic boyutu zaten taşır; yalnızca hedef genişlik veriyoruz.
    <Image src={cover} alt={alt} width={width} height={height} class={className} loading={loading} />
  )
}
