---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { getMessages } from '../../messages';
import type { Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { about } = getMessages(locale);
---

<Section id="about">
  <Container class="max-w-3xl">
    <SectionHeading eyebrow={about.eyebrow} title={about.title} align="left" />
    <div class="space-y-4 text-lg text-gray-600 dark:text-gray-400" data-reveal>
      {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </Container>
</Section>
