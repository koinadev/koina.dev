---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
/* @feature:forms */
import Button from '../ui/Button.astro';
/* @/feature:forms */
import { getMessages } from '../../messages';
import type { Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { cta } = getMessages(locale);
---

<Section id="cta">
  <Container>
    <div
      class="grid gap-8 rounded-[22px] bg-pine px-8 py-14 text-[#e6eee8] sm:px-12 lg:grid-cols-[1fr_auto] lg:items-end dark:bg-gray-900"
      data-reveal
    >
      <div>
        <h2 class="font-display text-4xl leading-[1.02] font-bold tracking-[-0.03em] sm:text-5xl">{cta.title}</h2>
        <p class="mt-4 max-w-xl text-[#e6eee8]/75">{cta.description}</p>
      </div>
      <!-- @feature:forms -->
      <Button
        href={cta.button.href}
        size="lg"
        class="!bg-pollen-400 !text-pine hover:!bg-pollen-300"
        analytics={{ event: 'cta_section' }}>{cta.button.label}</Button
      >
      <!-- @/feature:forms -->
    </div>
  </Container>
</Section>
