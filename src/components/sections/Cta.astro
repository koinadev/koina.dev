---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { getMessages } from '../../messages';
import type { Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { cta } = getMessages(locale);
---

<Section id="cta" class="!pt-8">
  <Container>
    <div
      class="relative overflow-hidden rounded-[36px] bg-primary px-6 py-16 text-center text-on-primary sm:px-12 sm:py-20"
    >
      <svg
        class="pointer-events-none absolute -bottom-20 -left-10 h-44 w-[45%] opacity-90"
        viewBox="0 0 600 200"
        aria-hidden="true"
      >
        <path
          d="M-20 160C80 60 200 40 280 110s200 80 340-40"
          fill="none"
          stroke="var(--k-squiggle)"
          stroke-width="22"
          stroke-linecap="round"></path>
      </svg>
      <p class="hand relative rotate-[-3deg] text-3xl">{cta.note}</p>
      <h2
        class="font-display relative mx-auto mt-3 max-w-2xl text-4xl leading-[1.05] text-balance sm:text-6xl"
      >
        {cta.title}
      </h2>
      <p class="relative mx-auto mt-5 max-w-xl text-lg opacity-80">{cta.description}</p>
      <!-- @feature:forms -->
      <Button
        href={cta.button.href}
        size="lg"
        class="relative mt-9 !bg-foreground !text-background"
        analytics={{ event: 'cta_section' }}>{cta.button.label}</Button
      >
      <!-- @/feature:forms -->
      <Button
        href={cta.secondary.href}
        size="lg"
        variant="secondary"
        class="relative mt-3 !border-foreground sm:mt-9 sm:ml-2"
        analytics={{ event: 'cta_section', cta: 'links' }}>{cta.secondary.label}</Button
      >
    </div>
  </Container>
</Section>
