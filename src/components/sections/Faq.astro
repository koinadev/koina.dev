---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import JsonLd from '../seo/JsonLd.astro';
import Icon from '../ui/Icon.astro';
import ActionLink from '../page/ActionLink.astro';
import { getMessages } from '../../messages';
import type { Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { faq, home } = getMessages(locale);
---

<Section id="faq">
  <Container class="max-w-3xl">
    <SectionHeading eyebrow={faq.eyebrow} title={faq.title} />
    <div class="space-y-3">
      {
        faq.items.map((item) => (
          <details class="group rounded-3xl bg-surface px-6 shadow-[0_1px_0_var(--k-line)]">
            <summary class="flex cursor-pointer items-center justify-between gap-6 py-5 text-[17px] font-semibold [&::-webkit-details-marker]:hidden">
              {item.question}
              <span
                class="grid size-8 shrink-0 place-items-center rounded-full bg-primary text-on-primary"
                aria-hidden="true"
              >
                <Icon
                  name="Add01Icon"
                  class="size-4 transition-transform group-open:rotate-45"
                  strokeWidth={2}
                />
              </span>
            </summary>
            <p class="pb-6 leading-relaxed text-muted-foreground">{item.answer}</p>
          </details>
        ))
      }
    </div>
    <div class="mt-8 text-center"><ActionLink action={home.faqLink} {locale} /></div>
  </Container>
</Section>
<JsonLd
  data={{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.items.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  }}
/>
