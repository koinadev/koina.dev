---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
import Reveal from '../ui/Reveal.astro';
import { getMessages } from '../../messages';
import type { Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
  variant?: 'grid' | 'alternating';
}
const { locale, variant = 'grid' } = Astro.props;
const { features } = getMessages(locale);

const icons: Record<string, string> = {
  zap: 'M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z',
  shield:
    'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z',
  globe:
    'M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418',
  chart:
    'M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z',
  sparkles:
    'M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z',
  code: 'M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5',
};

// Eksik bir ikon adı sessizce boş `<path d="">` üretmesin — build zamanında yüksek sesle patlasın.
function iconPath(name: string): string {
  const path = icons[name];
  if (!path) {
    throw new Error(
      `Features: bilinmeyen ikon "${name}". src/components/sections/Features.astro içindeki icons haritasına ekleyin.`,
    );
  }
  return path;
}
---

<Section id="features">
  <Container>
    <SectionHeading eyebrow={features.eyebrow} title={features.title} description={features.description} />
    {
      variant === 'grid' && (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {features.items.map((item, i) => (
            <Reveal delay={(i % 3) * 0.1}>
              <Card class="h-full transition-shadow hover:shadow-md">
                <div class="mb-4 flex size-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600 dark:bg-brand-950 dark:text-brand-400">
                  <svg
                    class="size-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d={iconPath(item.icon)} />
                  </svg>
                </div>
                <h3 class="mb-2 font-semibold">{item.title}</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400">{item.description}</p>
              </Card>
            </Reveal>
          ))}
        </div>
      )
    }
    {
      variant === 'alternating' && (
        <div class="space-y-16">
          {features.items.map((item, i) => (
            <div
              class:list={[
                'grid items-center gap-8 lg:grid-cols-2',
                i % 2 === 1 && 'lg:[&>*:first-child]:order-2',
              ]}
              data-reveal
            >
              <div>
                <h3 class="text-2xl font-bold">{item.title}</h3>
                <p class="mt-3 text-gray-600 dark:text-gray-400">{item.description}</p>
              </div>
              <div class="flex h-48 items-center justify-center rounded-2xl bg-gray-100 dark:bg-gray-900">
                <svg
                  class="size-12 text-brand-500"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d={iconPath(item.icon)} />
                </svg>
              </div>
            </div>
          ))}
        </div>
      )
    }
  </Container>
</Section>
