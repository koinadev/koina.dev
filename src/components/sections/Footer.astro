---
import Container from '../ui/Container.astro';
import Mark from '../ui/Mark.astro';
import Icon from '../ui/Icon.astro';
import { getMessages } from '../../messages';
import { siteConfig } from '../../config/site.config';
import { useTranslations, type Locale } from '../../i18n/utils';
import { isActiveNav, navHref, type NavLink, type RouteKey } from '../../i18n/routes';
import { routePath } from '../../i18n/routes'; // @feature:blog
import type { IconName } from '../../lib/icons';

interface Props {
  locale: Locale;
  // Header ile aynı sözleşme: aktif link route anahtarından bilinir, pathname'den değil.
  route?: RouteKey;
}
const { locale, route } = Astro.props;
const { nav } = getMessages(locale);
const t = useTranslations(locale);
const year = new Date().getFullYear();
// Marka ikonları Hugeicons'tan; adres boşsa o profil gösterilmez.
const socialIcons: Record<string, [IconName, string]> = {
  discord: ['DiscordIcon', 'Discord'],
  youtube: ['YoutubeIcon', 'YouTube'],
  instagram: ['InstagramIcon', 'Instagram'],
  x: ['NewTwitterIcon', 'X'],
  linkedin: ['Linkedin01Icon', 'LinkedIn'],
  github: ['GithubIcon', 'GitHub'],
};
const socials = Object.entries(siteConfig.socials).filter(([name, href]) => href && socialIcons[name]);
const columns: [string, NavLink[]][] = [
  [t('footer.groups.community'), nav.footer.community],
  [t('footer.groups.join'), nav.footer.join],
  [t('footer.groups.support'), [...nav.footer.support, ...nav.legal]],
];
/* @feature:blog */
// Bkz. BaseLayout: aynı türetme.
const rssHref = `${routePath('home', locale)}rss.xml`;
/* @/feature:blog */
---

<footer class="mt-8 border-t border-line">
  <Container class="grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1fr]">
    <div>
      <div class="flex items-center gap-2.5">
        <Mark class="size-7" />
        <span class="font-display text-2xl leading-none">{siteConfig.name.toLowerCase()}</span>
      </div>
      <p class="mt-4 max-w-xs text-muted-foreground">{t('footer.free')}</p>
      <ul class="mt-6 flex flex-wrap gap-1.5" aria-label={t('footer.groups.follow')}>
        {
          socials.map(([name, href]) => (
            <li>
              <a
                {href}
                rel="noopener"
                target="_blank"
                class="grid size-9 place-items-center rounded-full bg-surface text-foreground shadow-[0_1px_0_var(--k-line)] hover:bg-primary"
              >
                <Icon name={socialIcons[name][0]} class="size-5" label={socialIcons[name][1]} />
              </a>
            </li>
          ))
        }
        <!-- @feature:blog -->
        <li>
          <a
            href={rssHref}
            class="grid size-9 place-items-center rounded-full bg-surface shadow-[0_1px_0_var(--k-line)] hover:bg-primary"
          >
            <Icon name="RssIcon" class="size-5" label="RSS" />
          </a>
        </li>
        <!-- @/feature:blog -->
      </ul>
    </div>
    {
      columns.map(([title, links]) => (
        <nav aria-label={title}>
          <p class="font-display text-lg">{title}</p>
          <ul class="mt-4 space-y-2.5 text-[15px]">
            {links.map((link) => (
              <li>
                <a
                  href={navHref(link, locale)}
                  aria-current={isActiveNav(link, route) ? 'page' : undefined}
                  class:list={[
                    isActiveNav(link, route)
                      ? 'text-foreground'
                      : 'text-muted-foreground hover:text-foreground',
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </Container>
  <Container class="label flex flex-wrap justify-between gap-2 border-t border-line py-6">
    <span>{`© ${year} ${siteConfig.name}`}</span>
    <!-- AGPL-3.0 §13: siteyi kullananlara kaynak koduna erişim sunulur. -->
    <a href={siteConfig.sourceUrl} class="hover:text-foreground">{t('footer.source')}</a>
  </Container>
</footer>
