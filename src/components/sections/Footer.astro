---
import Container from '../ui/Container.astro';
import { getMessages } from '../../messages';
import { siteConfig } from '../../config/site.config';
import { useTranslations, type Locale } from '../../i18n/utils';
import { isActiveNav, navHref, type RouteKey } from '../../i18n/routes';
import { routePath } from '../../i18n/routes'; // @feature:blog

interface Props {
  locale: Locale;
  // Header ile aynı sözleşme: aktif link route anahtarından bilinir, pathname'den değil.
  route?: RouteKey;
}
const { locale, route } = Astro.props;
const { nav } = getMessages(locale);
const t = useTranslations(locale);
const year = new Date().getFullYear();
const socialEntries = Object.entries(siteConfig.socials).filter(([, href]) => href);
// Anahtar adı etiket olarak gösteriliyor; markaların kendi yazımı için küçük bir eşleme.
const socialLabels: Record<string, string> = { github: 'GitHub', linkedin: 'LinkedIn', youtube: 'YouTube', x: 'X' };
/* @feature:blog */
// Bkz. BaseLayout: aynı türetme.
const rssHref = `${routePath('home', locale)}rss.xml`;
/* @/feature:blog */
---

<footer class="border-t border-gray-200 py-12 dark:border-gray-800">
  <Container class="flex flex-col items-center gap-8 md:flex-row md:justify-between">
    <div class="flex items-center gap-2.5">
      <img src={siteConfig.logo} alt="" class="size-7" />
      <span class="font-display text-2xl leading-none font-extrabold tracking-[-0.04em]">{siteConfig.name.toLowerCase()}</span>
    </div>
    <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2" aria-label={t('nav.footerMenu')}>
      {
        [...nav.links, ...nav.legal].map((link) => (
          <a
            href={navHref(link, locale)}
            aria-current={isActiveNav(link, route) ? 'page' : undefined}
            class:list={[
              'text-sm',
              isActiveNav(link, route)
                ? 'font-medium text-gray-900 dark:text-white'
                : 'text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="flex flex-wrap justify-center gap-x-4 gap-y-2">
      {
        socialEntries.map(([name, href]) => (
          <a
            {href}
            rel="noopener"
            target="_blank"
            class="text-sm text-gray-600 capitalize hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
          >
            {socialLabels[name] ?? name}
          </a>
        ))
      }
      <!-- @feature:blog -->
      <a
        href={rssHref}
        class="text-sm text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white">RSS</a
      >
      <!-- @/feature:blog -->
    </div>
  </Container>
  <Container class="mt-8 text-center text-sm text-gray-600 dark:text-gray-400">
    {`© ${year} ${siteConfig.name}. `}
    <!-- AGPL-3.0 §13: siteyi kullananlara kaynak koduna erişim sunulur. -->
    <a href={siteConfig.sourceUrl} class="underline underline-offset-2 hover:text-gray-900 dark:hover:text-white"
      >{t('footer.source')}</a
    >
  </Container>
</footer>
