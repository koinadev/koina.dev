---
import Container from '../ui/Container.astro';
import Mark from '../ui/Mark.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { getMessages } from '../../messages';
import { siteConfig } from '../../config/site.config';
import { useTranslations, type Locale } from '../../i18n/utils';
import { isActiveNav, navHref, routePath, type Alternates, type RouteKey } from '../../i18n/routes';

interface Props {
  locale: Locale;
  // Sayfanın tüm dillerdeki karşılıkları. Dil değiştirici bunu kullanır; URL'i geriye doğru
  // parse etmek lokalize slug'larda ve blog yazılarında ZATEN imkânsız olurdu.
  alternates?: Alternates;
  // Şu an açık olan sayfanın route anahtarı; aktif link işaretlemesi bunu kullanır.
  route?: RouteKey;
}
const { locale, route } = Astro.props;
const { nav } = getMessages(locale);
const t = useTranslations(locale);
const homeHref = routePath('home', locale);
// Mobil menünün alt listesi: büyük linklerde olmayan diğer tüm sayfalar.
const mainRoutes = new Set(nav.links.map((l) => l.route));
const moreLinks = [...nav.footer.community, ...nav.footer.join, ...nav.footer.support].filter(
  (l) => !mainRoutes.has(l.route) && l.route !== 'links' && l.route !== 'home',
);
/* @feature:i18n */
// Bu satırlar i18n marker bloğu içinde olmalı: dışarıda kalırsa i18n çıkarıldığında `'en'`
// geçerli bir `Locale` olmadığı için tip hatası verir.
const otherLocale: Locale = locale === 'tr' ? 'en' : 'tr';
const tOther = useTranslations(otherLocale);
// `alternates` marker bloğunun içinde okunuyor — dışarıda destructure edilseydi i18n
// çıkarıldığında okuyanı kalmaz, ts(6133) uyarısı üretirdi (doğrulandı).
// `alternates` verilmemişse (404 gibi) diğer dilin ana sayfasına düşülür, 404'e değil.
const switchHref = Astro.props.alternates?.[otherLocale] ?? routePath('home', otherLocale);
/* @/feature:i18n */
---

<header transition:animate="none" class="sticky top-0 z-50 bg-background/85 backdrop-blur-md">
  <Container class="flex h-20 items-center justify-between">
    <a href={homeHref} aria-current={route === 'home' ? 'page' : undefined} class="flex items-center gap-2.5">
      <Mark class="size-7" />
      <span class="font-display text-2xl leading-none">{siteConfig.name.toLowerCase()}</span>
    </a>
    <nav class="hidden items-center gap-6 md:flex" aria-label={t('nav.mainMenu')}>
      {
        nav.links.map((link) => (
          <a
            href={navHref(link, locale)}
            aria-current={isActiveNav(link, route) ? 'page' : undefined}
            class:list={[
              'relative text-[15px] font-medium transition-colors',
              'after:absolute after:inset-x-0 after:-bottom-1.5 after:h-0.5 after:rounded-full after:bg-squiggle after:h-1 after:opacity-0',
              isActiveNav(link, route)
                ? 'text-foreground after:opacity-100'
                : 'text-foreground/80 hover:text-foreground',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-2">
      <!-- @feature:i18n -->
      <a
        href={switchHref}
        data-locale-switch={otherLocale}
        class="rounded-full px-2 py-1 font-mono text-xs text-muted-foreground uppercase hover:text-foreground"
        aria-label={tOther('nav.switchLocale')}>{otherLocale}</a
      >
      <!-- @/feature:i18n -->
      <div>
        <Button
          href={navHref(nav.cta, locale)}
          class="max-md:h-9 max-md:px-4"
          analytics={{ event: 'header_cta', place: 'desktop' }}
        >
          {nav.cta.label}
        </Button>
      </div>
      <button
        type="button"
        data-menu-toggle
        data-menu-labels={JSON.stringify({ open: t('nav.menu'), close: t('nav.close') })}
        aria-label={t('nav.menu')}
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="rounded-lg p-2 hover:bg-gray-100 md:hidden"
      >
        <Icon name="Menu01Icon" class="size-6" />
      </button>
    </div>
  </Container>
</header>
<!--
  Tam ekran mobil menü. `header`ın DIŞINDA: başlıktaki `backdrop-blur` sabit konumlu çocuklar için
  yeni bir kapsayıcı oluşturur, içeride kalsaydı panel ekranı değil başlığı doldururdu.
  `nav` landmark'ı + `aria-label` (masaüstü etiketinden farklı); `id` düğmedeki `aria-controls` ile eşleşir.
-->
<nav
  id="mobile-menu"
  data-mobile-menu
  hidden
  transition:animate="none"
  aria-label={t('nav.menu')}
  class="fixed inset-0 z-[70] flex flex-col overflow-y-auto bg-background md:hidden"
>
  <Container class="flex h-20 shrink-0 items-center justify-between">
    <a href={homeHref} class="flex items-center gap-2.5">
      <Mark class="size-7" />
      <span class="font-display text-2xl leading-none">{siteConfig.name.toLowerCase()}</span>
    </a>
    <button
      type="button"
      data-menu-close
      aria-label={t('nav.close')}
      class="grid size-11 place-items-center rounded-full bg-surface shadow-[0_1px_0_var(--k-line)]"
    >
      <Icon name="Cancel01Icon" class="size-6" />
    </button>
  </Container>
  <Container class="flex flex-1 flex-col pt-2 pb-4">
    <ul class="space-y-1">
      {
        [...nav.links, { label: t('nav.links'), route: 'links' as const }].map((link) => (
          <li>
            <a
              href={navHref(link, locale)}
              aria-current={isActiveNav(link, route) ? 'page' : undefined}
              class:list={[
                'font-display flex items-center justify-between py-2 text-[1.75rem] leading-tight',
                isActiveNav(link, route) && 'text-primary-text',
              ]}
            >
              {link.label}
              <Icon name="ArrowRight01Icon" class="size-6 opacity-40" />
            </a>
          </li>
        ))
      }
    </ul>
    <ul class="mt-8 grid grid-cols-2 gap-x-4 gap-y-3 border-t border-line pt-6 text-[15px]">
      {
        moreLinks.map((link) => (
          <li>
            <a href={navHref(link, locale)} class="text-muted-foreground hover:text-foreground">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="sticky bottom-0 mt-auto bg-background pt-8 pb-2">
      <p class="hand mb-2 -rotate-2 text-center text-2xl text-primary-text">{t('nav.free')}</p>
      <Button
        href={navHref(nav.cta, locale)}
        size="lg"
        class="w-full"
        analytics={{ event: 'header_cta', place: 'mobile' }}
      >
        {nav.cta.label}
      </Button>
    </div>
  </Container>
</nav>
<script>
  const { initMobileMenu } = await import('../../lib/mobile-menu');
  initMobileMenu();
</script>
<!-- @feature:i18n -->
<script>
  const { initLocaleSwitch } = await import('../../lib/locale-switch');
  initLocaleSwitch();
</script>
<!-- @/feature:i18n -->
