---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { getMessages } from '../../messages';
import { siteConfig } from '../../config/site.config';
import type { Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { newsletter } = getMessages(locale);
---

<Section id="newsletter" class="!pt-4 !pb-24">
  <Container class="max-w-2xl text-center">
    <h2 class="font-display text-3xl">{newsletter.title}</h2>
    <p class="mt-3 text-muted-foreground">{newsletter.description}</p>
    <!--
      `data-astro-reload`: ClientRouter POST formlarını yakalayıp kendi fetch'ini yapıyor —
      sağlayıcı bağlanmamış olsa bile mevcut sayfaya gerçek bir POST atardı.
      Etiket sr-only: placeholder erişilebilir ad DEĞİLDİR (odaklanınca kaybolur, WCAG 1.3.1/3.3.2).
    -->
    <form
      method="post"
      action={siteConfig.newsletter.action || '#'}
      data-astro-reload
      class="mx-auto mt-7 flex max-w-md gap-2"
    >
      <label class="sr-only" for="newsletter-email">{newsletter.emailLabel}</label>
      <input
        id="newsletter-email"
        type="email"
        name="email"
        required
        placeholder={newsletter.placeholder}
        class="h-12 w-full rounded-full border-2 border-line bg-surface px-5 text-[15px] placeholder:text-muted-foreground focus:border-accent focus:outline-none"
      />
      <Button type="submit" size="lg" analytics={{ event: 'newsletter_submit' }}
        >{newsletter.subscribe}</Button
      >
    </form>
  </Container>
</Section>
