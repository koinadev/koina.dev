---
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import stream from '../../assets/photos/stream.jpg';
import { getMessages } from '../../messages';
import type { Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
  headingLevel?: 'h1' | 'h2';
  // Etkinlikler sayfası fotoğrafsız, tam genişlik liste ister.
  photo?: boolean;
}
const { locale, headingLevel = 'h2', photo = true } = Astro.props;
const { rhythm } = getMessages(locale);
const liveLabel = locale === 'tr' ? 'Canlı yayın' : 'Live stream';
---

<Section id={locale === 'tr' ? 'ritim' : 'rhythm'}>
  <Container>
    <SectionHeading
      eyebrow={rhythm.eyebrow}
      title={rhythm.title}
      description={rhythm.description}
      as={headingLevel}
    />
    <div class:list={['grid items-start gap-8', photo && 'lg:grid-cols-[1fr_1.25fr]']}>
      {
        photo && (
          <Image
            src={stream}
            alt={rhythm.photoAlt}
            widths={[480, 800, 1000]}
            sizes="(min-width: 1024px) 460px, 100vw"
            class="aspect-[4/3] w-full rounded-[28px] object-cover lg:aspect-[4/5]"
          />
        )
      }
      <ul class="rounded-[28px] bg-surface p-2 shadow-[0_1px_0_var(--k-line)]">
        {
          rhythm.items.map((item, i) => (
            <li
              class:list={[
                'grid grid-cols-[6.5rem_1fr] gap-x-4 gap-y-1 px-5 py-4 sm:grid-cols-[7.5rem_4rem_1fr]',
                i > 0 && 'border-t border-line',
              ]}
            >
              <span class="font-display text-lg">{item.day}</span>
              <span class="font-mono text-sm text-muted-foreground sm:pt-1">{item.time}</span>
              <span class="col-span-2 sm:col-span-1">
                <span class="flex items-center gap-2">
                  {item.live && (
                    <span class="size-2 shrink-0 rounded-full bg-live" title={liveLabel}>
                      <span class="sr-only">{liveLabel}: </span>
                    </span>
                  )}
                  {item.what}
                </span>
                <span class="text-sm text-muted-foreground">{item.where}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</Section>
