---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { getMessages } from '../../messages';
import type { Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { season } = getMessages(locale);
const last = season.steps.length - 1;
---

<!-- Gerçek bir sıra (hafta 0 → 6): duraklar bir çizgi üstünde, son durak Demo Günü. -->
<Section class="bg-surface">
  <Container>
    <SectionHeading eyebrow={season.eyebrow} title={season.title} description={season.description} />
    <ol class="relative grid gap-8 sm:grid-cols-2 lg:grid-cols-6 lg:gap-5">
      <span
        class="absolute top-[9px] right-[8%] left-[8%] hidden h-1 rounded-full bg-squiggle lg:block"
        aria-hidden="true"></span>
      {
        season.steps.map((step, i) => (
          <li class="relative flex gap-4 lg:flex-col lg:items-center lg:text-center">
            <span
              class:list={[
                'relative z-10 mt-0.5 size-[22px] shrink-0 rounded-full border-4 border-surface',
                i === last ? 'bg-primary-text' : 'bg-foreground',
              ]}
              aria-hidden="true"
            />
            <div>
              <p class="label">{step.week}</p>
              <p class="font-display mt-1 text-xl">{step.name}</p>
              <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Container>
</Section>
