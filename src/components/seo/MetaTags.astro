---
import { siteConfig, ogImageSize } from '../../config/site.config';
/* @feature:i18n */
// i18n bağımlılığı tek bloğa kapatıldı; Props interface'i blok dışında, i18n kaldırılsa bile
// MetaTags imzası aynı kalır.
import type { Alternates } from '../../i18n/routes';
import { defaultLocale, getLocaleMeta, type Locale } from '../../i18n/utils';
/* @/feature:i18n */

interface Props {
  title: string;
  description: string;
  image?: string;
  locale: string;
  noindex?: boolean;
  alternates?: Record<string, string>;
  /**
   * OG içerik türü. `article` YALNIZCA blog yazılarında kullanılır: sosyal kazıyıcılar ve
   * Google Discover için bir sayfayı "yazı" yapan tek sinyal budur, `<article>` etiketi değil.
   */
  type?: 'website' | 'article';
  /** ISO 8601 yayın tarihi; yalnızca `type="article"` ile anlam taşır. */
  publishedTime?: string;
  /** ISO 8601 son güncelleme; yoksa hiç yazılmaz (boş `content` yanlış sinyaldir). */
  modifiedTime?: string;
}
const {
  title,
  description,
  image = '/og/home.png',
  noindex = false,
  type = 'website',
  publishedTime,
  modifiedTime,
} = Astro.props;
/* @feature:i18n */
const { locale, alternates: alternatesRaw } = Astro.props;
const alternates = alternatesRaw as Alternates | undefined;
/* @/feature:i18n */
const site = Astro.site ?? siteConfig.url;
// Ölçüldü: `build.format: 'directory'` + `trailingSlash: 'ignore'` yüzünden prerender edilen
// her sayfanın `Astro.url.pathname`'i sondaki slash'i taşır — kanonik, sitemap ve hreflang
// aynı biçimde olmalı.
const canonical = new URL(Astro.url.pathname, site);
// Kanonik yalnızca indekslenen sayfalara yazılır: 404 dosyası `404.html` ama `Astro.url.pathname`
// `/404/` der, kanonik olmadan noindex ile çelişmez (ölçüldü).
/* @feature:i18n */
// `og:locale` alt çizgili biçim bekler (`tr_TR`); `htmlLang`'tan doğrudan üretiyoruz.
const ogLocale = getLocaleMeta(locale as Locale).htmlLang.replace('-', '_');
/* @/feature:i18n */
---

<title>{title}</title>
<meta name="description" content={description} />
{!noindex && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={new URL(image, site)} />
{
  /*
  Boyut ETİKETLERİ olmadan Slack/WhatsApp gibi kazıyıcılar görseli indirene kadar önizleme
  kutusunu ölçemez ve çoğu küçük kart'a düşer. Değer `ogImageSize`tan geliyor — OG görsellerinin
  TAMAMI aynı satori tuvalinden çıktığı için sabittir; `image` prop'una farklı ölçüde bir dosya
  verilirse burası da güncellenmelidir.
*/
}
<meta property="og:image:width" content={String(ogImageSize.width)} />
<meta property="og:image:height" content={String(ogImageSize.height)} />
<meta property="og:image:alt" content={title} />
{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
<!-- @feature:i18n -->
<meta property="og:locale" content={ogLocale} />
<!-- @/feature:i18n -->
<meta name="twitter:card" content="summary_large_image" />
{/* Mülk doğrulama etiketleri: yalnızca DOLUYKEN yazılır (bkz. siteConfig.verification). */}
{
  siteConfig.verification.google && (
    <meta name="google-site-verification" content={siteConfig.verification.google} />
  )
}
{siteConfig.verification.bing && <meta name="msvalidate.01" content={siteConfig.verification.bing} />}
<!-- @feature:i18n -->
{
  alternates &&
    Object.entries(alternates).map(([code, path]) => (
      <link rel="alternate" hreflang={code} href={new URL(path, site)} />
    ))
}
{alternates && <link rel="alternate" hreflang="x-default" href={new URL(alternates[defaultLocale], site)} />}
<!-- @/feature:i18n -->
