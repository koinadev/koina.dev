---
interface Props {
  label: string;
  name: string;
  type?: string;
  required?: boolean;
  textarea?: boolean;
  /**
   * Gateway sözleşmesinin alt sınırını TARAYICIYA taşır (`name` 2, `message` 10 karakter —
   * bkz. nafru-form/src/http/validation.ts). Sunucu tarafı zaten reddediyor; burada
   * bildirilmezse kullanıcı `INVALID_SUBMISSION` sonrası ayrımsız bir hata mesajı görür.
   */
  minlength?: number;
  hint?: string;
  autocomplete?: astroHTML.JSX.InputHTMLAttributes['autocomplete'];
}
const {
  label,
  name,
  type = 'text',
  required = false,
  textarea = false,
  minlength,
  hint,
  autocomplete,
} = Astro.props;
const classes =
  'w-full rounded-2xl border border-input bg-surface px-4 py-3 text-base placeholder:text-muted-foreground focus:border-foreground focus:outline-none';
---

<label class="block">
  <span class="mb-1.5 block text-[15px] font-medium"
    >{label}{hint && <span class="font-normal text-muted-foreground"> ({hint})</span>}</span
  >
  {
    textarea ? (
      <textarea {name} {required} {minlength} rows="4" class={classes} />
    ) : (
      <input
        type={type as astroHTML.JSX.HTMLInputTypeAttribute}
        {name}
        {required}
        {minlength}
        {autocomplete}
        class={classes}
      />
    )
  }
</label>
