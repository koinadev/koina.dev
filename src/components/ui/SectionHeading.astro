---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'center' | 'left';
  // Varsayılan `h2`: bölüm başlıkları Hero'nun `<h1>`inin altında yaşar. Kendi `<h1>`i olmayan
  // sayfalar (iletişim, gizlilik) `as="h1"` geçer.
  as?: 'h1' | 'h2' | 'h3';
}
const { eyebrow, title, description, align = 'center', as: Tag = 'h2' } = Astro.props;
---

<div class:list={['mb-12 max-w-2xl', align === 'center' ? 'mx-auto text-center' : '']} data-reveal>
  {
    eyebrow && (
      <p class="mb-3 text-sm font-semibold text-brand-700 dark:text-brand-300">
        {eyebrow}
      </p>
    )
  }
  <Tag class="font-display text-4xl leading-[1.02] font-bold tracking-[-0.03em] text-balance sm:text-5xl">{title}</Tag>
  {description && <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">{description}</p>}
</div>
