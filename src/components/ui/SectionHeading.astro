---
interface Props {
  // Başlığın üstündeki el yazısı not (isteğe bağlı). Etiket değil, bir yorum gibi okunmalı.
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'center' | 'left';
  // Varsayılan `h2`: bölüm başlıkları Hero'nun `<h1>`inin altında yaşar. Kendi `<h1>`i olmayan
  // sayfalar (iletişim, gizlilik) `as="h1"` geçer.
  as?: 'h1' | 'h2' | 'h3';
}
const { eyebrow, title, description, align = 'center', as: Tag = 'h2' } = Astro.props;
---

<div class:list={['mb-14 max-w-3xl', align === 'center' ? 'mx-auto text-center' : '']}>
  {eyebrow && <p class="hand mb-3 -rotate-2 text-2xl text-primary-text">{eyebrow}</p>}
  <Tag class="font-display text-4xl leading-[1.08] text-balance sm:text-5xl">{title}</Tag>
  {
    description && (
      <p
        class:list={[
          'mt-5 text-lg leading-relaxed text-muted-foreground',
          align === 'center' && 'mx-auto max-w-2xl',
        ]}
      >
        {description}
      </p>
    )
  }
</div>
