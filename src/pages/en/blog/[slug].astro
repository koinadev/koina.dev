---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import BlogCover from '@/components/blog/Cover.astro';
import Section from '@/components/ui/Section.astro';
import PostJsonLd from '@/components/blog/PostJsonLd.astro';
import { formatDate, readingTime } from '@/lib/utils';
import { getMessages } from '@/messages';
import { blogPostPath, routePath, type Alternates, blogSlugFromId } from '@/i18n/routes';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.locale === 'en');
  return posts.map((post) => ({ params: { slug: blogSlugFromId(post.id, 'en') }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { blog } = getMessages('en');
const slug = blogSlugFromId(post.id, 'en');
// OG görselinin yolu İKİ tüketiciye gidiyor (`<meta og:image>` ve BlogPosting.image);
// tek değişken, iki yerde ayrı ayrı türetilmesin.
const ogImage = `/og/blog-${post.id.replaceAll('/', '-')}.png`;
// TR aynasının aksine burada `@feature:i18n` marker'ı YOK ve gerekmiyor: i18n çıkarıldığında
// `src/pages/en` KOMPLE siliniyor (dosya silme, marker süpürmesinden ÖNCE çalışır).
const trPost = (await getCollection('blog', ({ data }) => data.locale === 'tr')).find(
  (entry) => entry.data.translationKey === post.data.translationKey,
);
const trHref = trPost ? blogPostPath(blogSlugFromId(trPost.id, 'tr'), 'tr') : routePath('blog', 'tr');
const alternates: Alternates = {
  tr: trHref,
  en: blogPostPath(slug, 'en'),
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  locale="en"
  image={ogImage}
  {alternates}
  route="blog"
  type="article"
  publishedTime={post.data.date.toISOString()}
  modifiedTime={post.data.updated?.toISOString()}
>
  <Section>
    <Container class="max-w-3xl">
      <p class="text-sm text-gray-600">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, 'en')}</time>{' '}
        · {readingTime(post.body ?? '')}
        {blog.minRead}
      </p>
      {
        post.data.cover && (
          <BlogCover
            cover={post.data.cover}
            alt={post.data.coverAlt ?? post.data.title}
            width={1024}
            loading="eager"
            class="mt-6 w-full rounded-xl"
          />
        )
      }
      <h1 class="mt-2 mb-8 text-4xl font-bold">{post.data.title}</h1>
      <article class="prose prose-gray max-w-none prose-headings:font-semibold prose-a:text-brand-600">
        <Content />
      </article>
    </Container>
  </Section>
  <PostJsonLd
    locale="en"
    {slug}
    title={post.data.title}
    description={post.data.description}
    date={post.data.date}
    updated={post.data.updated}
    author={post.data.author}
    image={ogImage}
    blogTitle={blog.title}
  />
</BaseLayout>
