---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import Card from '@/components/ui/Card.astro';
import BlogCover from '@/components/blog/Cover.astro';
import { formatDate, readingTime } from '@/lib/utils';
import { getMessages } from '@/messages';
import { alternatesFor, blogPostPath, blogSlugFromId } from '@/i18n/routes';

const posts = (await getCollection('blog', ({ data }) => data.locale === 'en')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const { blog } = getMessages('en');
const alternates = alternatesFor('blog');
---

<BaseLayout
  title={`${blog.title} — ${blog.allPosts}`}
  description={blog.allPosts}
  locale="en"
  {alternates}
  route="blog"
>
  <Section>
    <Container class="max-w-4xl">
      <h1 class="mb-12 text-4xl font-bold">{blog.title}</h1>
      <div class="grid gap-6 sm:grid-cols-2">
        {
          posts.map((post) => (
            <a href={blogPostPath(blogSlugFromId(post.id, 'en'), 'en')} class="group">
              <Card class="h-full transition-shadow group-hover:shadow-md">
                {post.data.cover && (
                  <BlogCover
                    cover={post.data.cover}
                    alt={post.data.coverAlt ?? post.data.title}
                    width={640}
                    class="mb-4 aspect-video w-full rounded-lg object-cover"
                  />
                )}
                <p class="text-sm text-gray-600 dark:text-gray-400">
                  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, 'en')}</time> ·{' '}
                  {readingTime(post.body ?? '')} {blog.minRead}
                </p>
                <h2 class="mt-2 text-xl font-semibold group-hover:text-brand-600">{post.data.title}</h2>
                <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">{post.data.description}</p>
                <p class="mt-4 text-sm font-medium text-brand-600">{blog.readMore} →</p>
              </Card>
            </a>
          ))
        }
      </div>
    </Container>
  </Section>
</BaseLayout>
