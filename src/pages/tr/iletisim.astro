---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactForm from '@/components/sections/ContactForm.astro';
import { getMessages } from '@/messages';
import { alternatesFor } from '@/i18n/routes';

const { contact } = getMessages('tr');
const alternates = alternatesFor('contact');
---

<BaseLayout title={contact.title} description={contact.description} locale="tr" {alternates} route="contact">
  <ContactForm locale="tr" headingLevel="h1" />
</BaseLayout>
